{
  "name": "obsidian-mermaid-flow-enhancer",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "build": "node esbuild.config.mjs",
    "test": "node --test tests/unit/*.test.js",
    "test:integration": "playwright test",
    "check": "npm test && npm run test:integration && npm run build",
    "docker:check": "node scripts/run-docker.mjs check",
    "docker:record": "node scripts/run-docker.mjs record",
    "scan:virustotal": "node scripts/scan-virustotal.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "obsidian": "1.14.4",
    "@playwright/test": "1.64.0",
    "mermaid": "12.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
